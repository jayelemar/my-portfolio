# Existing private Discord destination
DISCORD_WEBHOOK_URL=

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile: Managed widget, public site key and private secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames, without protocols or paths
TURNSTILE_ALLOWED_HOSTNAMES=elemar.site,www.elemar.site
