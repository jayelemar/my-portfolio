  "narrative": {
    "northStar": "The Developer\u2019s Workbench",
    "overview": "The user explicitly confirmed that the existing green theme is the design authority. Preserve its Leaf Green, Forest Ink, Mint, light/dark themes, Inter typography, pill actions, and current portrait treatment during refinement. Earlier generated replacement directions are superseded.\n\nAn approachable, capable portfolio with open spacing, direct typography, green accents, and clear project demonstrations. The workbench metaphor describes the implemented system: personal identity gives the work a human author, and project screenshots supply concrete evidence of what he builds.\n\nComponents feel refined and restrained, with quiet boundaries, clear states, and generous spacing. Depth is layered: page surfaces stay calm while screenshot frames and the scrolled header receive structural shadows. Light and dark themes retain the same hierarchy and geometry.",
    "keyCharacteristics": [
      "A consistent green accent, supported by quieter green text and mint surfaces.",
      "One primary sans-serif family, with bold headings and muted explanatory copy.",
      "Pill actions, rounded fields, fine borders, and framed desktop/mobile project imagery.",
      "Spacious sections with responsive stacking and deliberate reveal motion."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Resolve background, text, border, and focus colors through their matching theme roles. A light-theme action foreground must not be carried into dark mode independently of its background.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep project-card shells free of shadows; put the existing preview elevation on the framed imagery inside them.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the existing green theme as the user-confirmed visual direction.",
      "Do use the matching semantic color roles for each theme.",
      "Do keep Inter as the primary family and reserve monospace for project indices.",
      "Do distinguish pill actions, category pills, and rectangular technology tags.",
      "Do keep project shells quiet and preview imagery visibly layered.",
      "Do preserve visible focus treatments and pair project-status color with text.",
      "Do follow each component's existing responsive behavior when refining it."
    ],
    "donts": [
      "Don't promote the malformed light foreground or red card/popover foregrounds into brand tokens.",
      "Don't collapse secondary, muted, and accent roles because their light values happen to match.",
      "Don't apply portrait shapes or horizontal showcase scrolling to unrelated surfaces by default.",
      "Don't replace real screenshots, identity assets, or technology marks with generic stand-ins.",
      "Don't describe missing focus, contrast, or reduced-motion coverage as verified compliance."
    ]
  }
}
