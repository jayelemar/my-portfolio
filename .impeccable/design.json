      "name": "Contact Field",
      "kind": "input",
      "refersTo": "input-contact",
      "description": "Contact form field with a floating border label, trailing icon, and theme focus ring.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-contact-name\">Name:</label><input class=\"ds-field-input\" id=\"ds-contact-name\" type=\"text\" autocomplete=\"name\" maxlength=\"80\"><svg class=\"ds-field-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></div>",
      "css": ".ds-field{position:relative;width:min(100%,400px);padding-top:8px}.ds-field-label{position:absolute;top:0;left:24px;z-index:1;padding:0 4px;background:hsl(var(--background, 0 0% 100%));color:hsl(var(--muted-foreground, 240 3.8% 46.1%));font-size:14px;line-height:20px;font-weight:500}.ds-field-input{display:block;width:100%;max-width:100%;height:54px;padding:8px 32px;font-family:inherit;font-size:16px;line-height:24px;border:1px solid hsl(var(--input, 240 5.9% 90%));border-radius:16px;background:hsl(var(--background, 0 0% 100%));color:inherit}.ds-field-input::placeholder{color:hsl(var(--muted-foreground, 240 3.8% 46.1%))}.ds-field-input:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 0 0% 100%)),0 0 0 4px hsl(var(--ring, 142.1 76.2% 36.3%))}.ds-field-input:disabled{cursor:not-allowed;opacity:0.5}.ds-field-icon{position:absolute;bottom:16px;right:24px;pointer-events:none}"
    },
