      "html": "<button class=\"ds-button-primary\" type=\"button\">Contact Me</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;font-family:inherit;font-size:14px;line-height:20px;font-weight:500;border:0;border-radius:calc(var(--radius, 8px) - 2px);height:40px;padding:8px 16px;background:hsl(var(--primary, 142.1 76.2% 36.3%));color:hsl(var(--primary-foreground, 355.7 100% 97.3%));cursor:pointer;transition:color 150ms cubic-bezier(0.4,0,0.2,1),background-color 150ms cubic-bezier(0.4,0,0.2,1)}.ds-button-primary:hover{background:hsl(var(--primary, 142.1 76.2% 36.3%) / 0.9);}.ds-button-primary:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 0 0% 100%)),0 0 0 4px hsl(var(--ring, 142.1 76.2% 36.3%))}.ds-button-primary:disabled{pointer-events:none;opacity:0.5}"
