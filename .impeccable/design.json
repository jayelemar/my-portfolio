    {
      "name": "Project Card",
      "kind": "card",
      "refersTo": "project-card",
      "description": "Project content shell with subdued border, green title, explicit status text, and no shell shadow. Framed imagery is a separate composition.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-meta\"><span class=\"ds-card-category\">AI Platform</span><span class=\"ds-card-status\"><i class=\"ds-card-dot\" aria-hidden=\"true\"></i>Live</span><span class=\"ds-card-index\">01</span></div><h3 class=\"ds-card-title\">Gondoor</h3><p class=\"ds-card-description\">An AI-powered operations platform that helps entrepreneurs launch, manage, and grow businesses with autonomous agents.</p><span class=\"ds-card-tag\">Automation</span><div class=\"ds-card-actions\"><a class=\"ds-card-link\" href=\"https://gondoor.app/en\" target=\"_blank\" rel=\"noopener noreferrer\">Visit live site<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></div></article>",
      "css": ".ds-card{max-width:400px;overflow:hidden;padding:20px;border:1px solid hsl(var(--border, 240 5.9% 90%) / 0.6);border-radius:var(--radius, 8px);background:hsl(var(--card, 0 0% 100%) / 0.7);box-shadow:none;font-family:inherit}.ds-card-meta{display:flex;align-items:center;gap:8px;margin-bottom:16px;color:hsl(var(--muted-foreground, 240 3.8% 46.1%));font-size:12px;line-height:16px;font-weight:500}.ds-card-category{padding:4px 12px;border:1px solid hsl(var(--border, 240 5.9% 90%));border-radius:9999px;background:hsl(var(--background, 0 0% 100%) / 0.7)}.ds-card-status{display:inline-flex;align-items:center;gap:6px}.ds-card-dot{display:inline-block;width:8px;height:8px;border-radius:9999px;background:hsl(var(--primary, 142.1 76.2% 36.3%))}.ds-card-index{margin-left:auto;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-weight:400;opacity:0.7}.ds-card-title{margin:0;color:hsl(var(--primary, 142.1 76.2% 36.3%));font-size:24px;line-height:32px;font-weight:700;letter-spacing:-0.025em}.ds-card-description{margin:12px 0 16px;color:hsl(var(--muted-foreground, 240 3.8% 46.1%));font-size:16px;line-height:1.625}.ds-card-tag{display:inline-block;padding:4px 10px;border-radius:6px;background:hsl(var(--muted, 240 4.8% 95.9%));color:hsl(var(--muted-foreground, 240 3.8% 46.1%));font-size:12px;line-height:16px;font-weight:500}.ds-card-actions{padding-top:20px}.ds-card-link{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:8px 16px;border-radius:9999px;background:hsl(var(--primary, 142.1 76.2% 36.3%));color:hsl(var(--primary-foreground, 355.7 100% 97.3%));font-size:14px;line-height:20px;font-weight:600;text-decoration:none;transition:transform 150ms}.ds-card-link:hover{transform:translateY(-2px)}.ds-card-link:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 0 0% 100%)),0 0 0 4px hsl(var(--ring, 142.1 76.2% 36.3%))}"
    }
